linters: linters_with_defaults(line_length_linter(80), object_name_linter = object_name_linter(styles = c("snake_case", "SNAKE_CASE")), pipe_continuation_linter = NULL, spaces_inside_linter = NULL, spaces_left_parentheses_linter = NULL)
exclusions: list("tests/testthat/", "data/", "docs/", "vignettes/", "man/", "inst/", ".Rprofile", ".Renviron", "renv.lock", "renv/")
